# Copy to .env.local. Do not commit real keys.

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SHIPPO_MODE=test
SHIPPO_TEST_API_KEY=
SHIPPO_LIVE_API_KEY=
SHIPPO_API_TOKEN=
SHIPPO_WEBHOOK_TOKEN=
SHIPPO_WEBHOOK_SECRET=
KAPO_SHIPPING_ORIGIN={"name":"KAPO","street1":"","city":"","state":"PA","zip":"","country":"US","email":"","phone":""}
KAPO_DEFAULT_CURRENCY=usd
KAPO_SHIPPING_HANDLING_FEE_CENTS=0
KAPO_SHIPPING_QUOTE_TTL_SECONDS=1800
KAPO_PRODUCTION_DAYS_MIN=5
KAPO_PRODUCTION_DAYS_MAX=10
KAPO_PARCEL_LENGTH_IN=8
KAPO_PARCEL_WIDTH_IN=6
KAPO_PARCEL_HEIGHT_IN=2
KAPO_PACKAGING_WEIGHT_GRAMS=35
KAPO_SHIP_TO_COUNTRIES=US
KAPO_DISCOUNT_CODES=
KAPO_ADMIN_EMAILS=
STRIPE_TAX_ENABLED=false
KAPO_ALLOW_LIVE_PAYMENTS=false
# Live postage stays off until this is true. Test tokens (shippo_test_) can buy test labels.
KAPO_ALLOW_LIVE_LABELS=false
# Clamped to $15 per label and $50 per day unless KAPO_LABEL_LIMITS_OVERRIDE=true.
KAPO_LABEL_MAX_CENTS=1500
KAPO_LABEL_DAILY_MAX_CENTS=5000
KAPO_LABEL_LIMITS_OVERRIDE=false
KAPO_SHIPPO_ENFORCE_IP_ALLOWLIST=false
RESEND_API_KEY=
KAPO_EMAIL_FROM=KAPO Orders <orders@shopkapo.com>
KAPO_PUBLIC_SITE_URL=https://shopkapo.com
KAPO_MAILING_ADDRESS=
KAPO_RESEND_AUDIENCE_ID=
# Optional Resend topic ids. When set, a full-topic announcement can send as a broadcast.
KAPO_RESEND_TOPIC_PRODUCTS=
KAPO_RESEND_TOPIC_DEALS=
KAPO_RESEND_TOPIC_YOUTUBE=
KAPO_RESEND_TOPIC_INSTAGRAM=
KAPO_RESEND_TOPIC_NEWS=
# YouTube PubSubHubbub. Leave blank to announce videos by hand.
KAPO_YOUTUBE_CHANNEL_ID=
KAPO_YOUTUBE_HUB_TOKEN=
RESEND_WEBHOOK_SECRET=
# Authorizes GET/POST /api/cron/newsletter. Monday sends the weekly digest.
KAPO_CRON_SECRET=
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
# Local only. Ignored when NODE_ENV is production.
KAPO_ADMIN_DEV_BYPASS=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=KAPO Support

# KAPO Club: keep disabled until staging/production acceptance is approved.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
KAPO_AUTHORIZED_ORIGINS=https://shopkapo.com,https://www.shopkapo.com
KAPO_SESSION_SECRET=
KAPO_CLUB_ENABLED=false
KAPO_REWARDS_REDEMPTION_ENABLED=false
KAPO_REWARD_EARN_RATE=10
KAPO_REWARD_VALUE_RATE=100
KAPO_REWARD_MINIMUM_POINTS=300
KAPO_REWARD_SIGNUP_BONUS=50
KAPO_REWARD_FIRST_ORDER_BONUS=100
KAPO_REWARD_MINIMUM_MERCHANDISE_CENTS=1000
